# Compile this thing with -nostdlib


; Register use:
; s2: input fd
; s3: output fd
; s4: pending high nibble or -1

; Uses top of the stack as i/o buffer

:_start
    rd_a1 rs1_sp !8 lw       ; Input file name

    ; Open input file and store FD in s2
    rd_a7 !56 addi           ; sys_openat
    rd_a0 !-100 addi         ; AT_FDCWD
    rd_a2 mv                 ; read only
    ecall
    rd_s2 rs1_a0 mv          ; Save fd in s2 for later

    ; Open output file and store the FD in s3
    rd_a0 !-100 addi         ; AT_FDCWD
    rd_a1 rs1_sp !12 lw      ; Output file (argument 3)
    rd_a2 !577 addi          ; octal 00001101
    ; O_TRUNC   00001000
    ; O_CREAT   00000100
    ; O_WRONLY  00000001
    ; OCTAL!
    rd_a3 !448 addi          ; Set read, write, execute permission on user
    ; S_IRWXU  00700
    ; OCTAL!
    ecall
    rd_s3 rs1_a0 mv          ; Save fd in s3 for later

    rd_a1 rs1_sp mv
    rd_a2 !1 addi
:pair
    rd_s4 !-1 addi
:normal
    rd_t2 $read jal
    rd_t0 !35 addi
    rs1_a0 rs2_t0 @comment beq
    rd_t0 !59 addi
    rs1_a0 rs2_t0 @decode bne
:comment
    rd_t2 $read jal
    rd_t0 !10 addi
    rs1_a0 rs2_t0 @normal beq
    rd_t0 !13 addi
    rs1_a0 rs2_t0 @comment bne
    $normal jal
:decode
    rd_t0 rs1_a0 !-48 addi
    rd_t1 rs1_t0 !10 sltiu
    rs1_t1 @digit bnez
    rd_t0 rs1_a0 !32 ori
    rd_t0 rs1_t0 !-97 addi
    rd_t1 rs1_t0 !6 sltiu
    rs1_t1 @normal beqz
    rd_t0 rs1_t0 !10 addi
:digit
    rs1_s4 @first bltz
    rd_t0 rs1_t0 rs2_s4 or
    rs1_sp rs2_t0 sb
    rd_a0 rs1_s3 mv
    rd_a7 !64 addi
    ecall
    $pair jal
:first
    rd_s4 rs1_t0 rs2_x4 slli
    $normal jal
:read
    rd_a0 rs1_s2 mv
    rd_a7 !63 addi
    ecall
    rs1_a0 @exit beqz
    rd_a0 rs1_sp lb
    rs1_t2 jalr
:exit
    rd_a7 !93 addi
    ecall
:ELF_end
